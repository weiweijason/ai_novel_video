# ========================================
# Video Worker - 環境變數設定
# ========================================
# 硬體需求: RTX 5080 16GB VRAM
#
# 使用方法:
# 1. 複製此檔案為 .env
#    cp .env.example .env
# 2. 修改 API_BASE_URL 為主機 IP
# 3. 修改 S3_ENDPOINT 為主機 MinIO IP
# ========================================

# --- API 連線設定 ---
API_BASE_URL=http://192.168.1.100:8000

# --- MinIO 連線設定 ---
S3_ENDPOINT=http://192.168.1.100:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=assets

# --- Worker 設定 ---
WORKER_ID=video-01
WORKER_HOSTNAME=video-worker

# --- Wan API 設定 ---
# 因為使用 network_mode: host，localhost 指向宿主機
WAN_API_URL=http://localhost:8080
WAN_API_KEY=your-api-key-here

# --- Wan 模型設定 ---
# 模型檔案放置位置: ./models/wan/Wan2.1-I2V-14B-720P-NF4.safetensors
WAN_MODEL_PATH=/models/wan/Wan2.1-I2V-14B-720P-NF4.safetensors
MOTION_MODEL_PATH=/models/motion

# --- 影片生成參數 ---
MAX_VIDEO_LENGTH=300
VIDEO_FPS=24
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_INFERENCE_STEPS=50
